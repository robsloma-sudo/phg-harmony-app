{
 "template_key": "bar_restaurant_standard",
 "about": "Vendor profiles for coding invoice lines to the bar_restaurant_standard chart. Built from the pattern of a real bar's coded invoices (used as an example only). A business's own vendors are matched to a profile once ('Who is Eagle Rock - a beer distributor?'), then the profile's rules are copied into phg.invoice_coding_rules for that vendor as source 'inferred' and confirmed in conversation. Patterns are case-insensitive regular expressions on the line description.",
 "general_rules": [
  {
   "key": "split_by_line",
   "rule": "Code each invoice line, not the invoice: one delivery can hold liquor, wine, mixers and supplies. In the example about 1 invoice in 9 was split across two or more GL codes."
  },
  {
   "key": "credits_same_gl",
   "rule": "Credits, returns and breakage credits go to the same GL code as the item, as a negative amount."
  },
  {
   "key": "deposits",
   "rule": "Keg, bottle and tank deposits go to 1200 Deposits; deposit refunds reverse them. Never COGS."
  },
  {
   "key": "freight",
   "rule": "Delivery charges and fuel surcharges go to 6270-10 / 6270-20 unless the business asks to fold them into the item's cost (setting finance.freight_into_cogs)."
  },
  {
   "key": "tax_on_invoice",
   "rule": "Sales tax paid on an invoice follows the lines it applies to, in proportion."
  },
  {
   "key": "capital_threshold",
   "rule": "A single item at or above the business's capitalization threshold (setting finance.capitalization_threshold, typically 2,500 USD) goes to 1500 Furniture & equipment, not an expense account. Ask when close."
  },
  {
   "key": "bar_only_food_lines",
   "rule": "In a bar with no kitchen, produce and grocery lines default to bar mix (5200-20 / 5200-10) instead of food (5300). Ask once which the business is."
  },
  {
   "key": "payment_method_is_not_gl",
   "rule": "How it was paid (vendor account, card, cash payout) is recorded separately; it never decides the GL code."
  },
  {
   "key": "brand_lexicon",
   "rule": "Before asking, check the line against PHG's brand lexicon (label-approval brand names with their spirit class): 'Casamigos' is tequila -> liquor, 'Josh' is wine. Bottle sizes alone never decide liquor vs wine."
  },
  {
   "key": "ask_when_unsure",
   "rule": "When no rule matches or two disagree, Harmony asks and saves the answer as a rule for that vendor and pattern."
  }
 ],
 "line_patterns": {
  "liquor": "tequila|mezcal|raicilla|sotol|vodka|\\bgin\\b|\\brum\\b|rhum|cacha[cç]a|whisk(e)?y|bourbon|\\brye\\b|scotch|cognac|armagnac|brandy|pisco|grappa|liqueur|amaro|aperitivo|absinthe|schnapps|triple sec|curacao|vermouth|blanco|reposado|a[nñ]ejo|\\bvsop\\b|\\bxo\\b|single malt|\\b\\d{1,2}\\s?(yr|year)",
  "beer": "\\bbeer\\b|\\bipa\\b|lager|\\bale\\b|stout|porter|pilsner|sour|hazy|cider|seltzer|\\bkeg\\b|1/2\\s?bbl|1/4\\s?bbl|1/6\\s?bbl|sixtel|\\b(12|16|19\\.2)\\s?oz\\b.*(can|btl)",
  "wine": "\\bwine\\b|cabernet|merlot|pinot|chardonnay|sauvignon|riesling|malbec|zinfandel|syrah|shiraz|tempranillo|ros[eé]\\b|prosecco|champagne|cava|cr[eé]mant|lambrusco|\\bsake\\b|port\\b|sherry",
  "mixers": "tonic|club soda|soda water|ginger beer|ginger ale|bitters|syrup|grenadine|puree|pur[eé]e|\\bjuice\\b|cream of coconut|orgeat|falernum|sour mix|bloody mary mix",
  "bar_produce": "lime|lemon|orange|grapefruit|mint|basil|cucumber|jalape[nñ]o|berries|pineapple|garnish|cherr(y|ies)|olive",
  "na_bev": "red bull|energy drink|bottled water|sparkling water|la croix|topo chico|coke|pepsi|sprite|n/a beer|non-?alcoholic|kombucha",
  "fountain": "bag.in.box|\\bbib\\b|fountain|post.?mix",
  "coffee_tea": "coffee|espresso|\\btea\\b|cold brew",
  "paper": "napkin|straw|to.?go|container|clamshell|\\bcup(s)?\\b|\\blid(s)?\\b|foil|film|paper towel|toilet|tissue|bag(s)?\\b|portion cup",
  "chemicals": "sanitizer|detergent|rinse aid|degreaser|bleach|chemical|cleaner|soap|glass wash",
  "bar_tools": "shaker|jigger|strainer|bar spoon|pour spout|speed rail|bar mat|muddler|pick(s)?\\b|ice scoop",
  "glassware": "glass(es|ware)?\\b|coupe|rocks glass|collins|pint glass|snifter|nick and nora",
  "smallwares": "pan(s)?\\b|sheet tray|cutting board|knife|tongs|ladle|whisk\\b|cambro|lexan|hotel pan|thermometer",
  "office": "printer|toner|ink|paper ream|pens?\\b|stapler|folder|label maker|office",
  "decor": "decor|flowers?|plant(s)?\\b|candle|string lights",
  "marketing_items": "flyer|poster|banner|sign(s)?\\b|sticker|promo|giveaway|swag|t-?shirt",
  "deposit": "deposit|keg dep|btl dep|tank dep|crv\\b",
  "freight": "delivery charge|freight|shipping",
  "fuel": "fuel surcharge|fuel adj",
  "music_gear": "speaker|karaoke|microphone|\\bmic\\b|projector|dj\\b|audio|amp(lifier)?\\b|hdmi|aux cable",
  "grounds": "lawn|garden|mulch|soil|snow|ice melt|rock salt|planter",
  "supplies_generic": "suppl(y|ies)|batter(y|ies)|light bulb|extension cord|trash bag|mop|broom"
 },
